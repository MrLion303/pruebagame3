/// =========================================================
/// OBJ_CAJA_CAMINO
/// CREATE
/// =========================================================
///
/// MARCADOR DE RUTA.
///
/// Coloca una instancia en CADA posición válida a la que una
/// caja puede llegar.
///
/// La caja buscará solamente estos marcadores y botones.
/// Por eso no puede salir de la ruta que tú diseñes.
///
/// RECOMENDADO:
///
///     - origen del sprite: Center / Middle Center
///     - usa un sprite visible en el Room Editor para diseñar
///       la ruta;
///     - en el juego se oculta automáticamente.
/// =========================================================

// Visible durante el juego para poder ver la ruta del puzzle.
// Si más adelante quieres volver a ocultarlos, cambia esto a false.
visible =
    true;

image_speed =
    0;
